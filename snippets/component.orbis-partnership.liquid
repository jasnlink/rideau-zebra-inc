{% comment %}
  ============================================================
  Orbis Partnership — explains Rideau Zebra's support of Orbis Canada.
  Include on product pages and homepage after the Featured Project section.
  ============================================================
{% endcomment %}

{% assign language = localization.language.iso_code %}

<div class="py-16 lg:py-24 bg-surface-white rz-gradient-surface-white">
    <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <div>
                <p class="rz-overline text-content-secondary">{{ 'sections.orbis_partnership.overline' | t }}</p>
                <h2 class="rz-h2 mt-2">{{ 'sections.orbis_partnership.title' | t }}</h2>
                <p class="mt-4 text-content-secondary leading-relaxed max-w-prose">
                    {{ 'sections.orbis_partnership.description_paragraph_1' | t }}
                </p>
                <p class="mt-3 text-content-secondary leading-relaxed max-w-prose">
                    {{ 'sections.orbis_partnership.description_paragraph_2' | t }}
                </p>
                <a href="https://www.orbis.org/{% if language == 'fr' %}fr{% else %}en{% endif %}" target="_blank" rel="noopener" class="inline-block mt-5 rz-btn-md rz-btn-secondary">
                    {{ 'sections.orbis_partnership.learn_more' | t }}
                </a>
            </div>
            <div class="relative order-first lg:order-none">
                <img src="{{ 'orbis-2.png' | asset_url }}" alt="Orbis Canada medical team" width="600" height="400" loading="lazy" class="w-full h-auto rounded-md shadow-lg">
                <div class="mt-4 flex justify-center">
                    <img src="{{ 'partner-logo-orbis.svg' | asset_url }}" alt="Orbis Canada" width="160" height="84" loading="lazy" class="h-10 sm:h-14 w-auto opacity-80">
                </div>
            </div>
        </div>

        {% comment %} Stat cards {% endcomment %}
        <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div class="text-center">
                <div class="rz-h1 text-content">2.2M+</div>
                <p class="mt-1 text-sm text-content-secondary">
                    {% if language == 'fr' %}dépistages et examens de la vue en 2024{% else %}eye screenings and examinations in 2024{% endif %}
                </p>
            </div>
            <div class="text-center">
                <div class="rz-h1 text-content">38,000+</div>
                <p class="mt-1 text-sm text-content-secondary">
                    {% if language == 'fr' %}formations pour professionnels de la santé{% else %}trainings for eye care professionals{% endif %}
                </p>
            </div>
            <div class="text-center">
                <div class="rz-h1 text-content">72,000+</div>
                <p class="mt-1 text-sm text-content-secondary">
                    {% if language == 'fr' %}paires de lunettes prescrites dans le monde{% else %}pairs of glasses prescribed worldwide{% endif %}
                </p>
            </div>
        </div>
    </div>
</div>
