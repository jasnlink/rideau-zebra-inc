{% capture drawer_content %}
    <div class="flex flex-col h-full">
        <div class="shrink border-b border-content/10">
            <div class="px-2 sm:px-8 flex justify-between items-center py-4 mx-auto">
                <span class="rz-h2 text-content">{{ 'templates.cart.your_cart' | t }}</span>
                <div role="button" data-drawer-close class="rz-icon-btn relative">
                    <div>{% render 'icon-close', class: 'h-5 w-auto fill-content-inverse text-content-inverse' %}</div>
                </div>
            </div>
        </div>
        <div id="cart-drawer-content" class="h-full shrink overflow-y-auto flex flex-col">
            {% comment %} ── Always-rendered template for JS inline rendering ── {% endcomment %}
            <template id="cart-item-template">
                    <div class="flex items-center gap-x-4 sm:gap-x-8" data-cart-line="">
                        <div>
                            <a href="" class="block aspect-square w-36 h-36 lg:w-44 lg:h-44 rounded-md select-none bg-content-light">
                                <img src="" alt="" height="132" width="132" loading="lazy" class="h-full w-auto object-contain rounded-md" />
                            </a>
                        </div>
                        <div class="flex-grow">
                            <div class="flex flex-col justify-center items-start">
                                <div class="w-full flex flex-col sm:flex-row justify-between gap-x-8">
                                    <a href="" class="sm:text-2xl font-bold font-serif"></a>
                                    <span class="font-light mt-1 sm:mt-0 text-sm sm:text-xl" data-cart-line-price></span>
                                </div>
                                <div class="mt-1 sm:mt-0 text-xs sm:text-lg text-content-secondary cart-item-variant" style="display:none"></div>
                                <div class="cart-item-properties mt-1"></div>
                                <div class="mt-1.5 flex justify-center items-center gap-2">
                                    <div role="button" data-cart-action="minus" data-cart-item-id="" data-cart-item-quantity="" class="py-1 px-2 relative">
                                        <span class="rz-cart-btn-icon">{% render 'icon-minus', class: 'h-3 w-3 text-content' %}</span>
                                        <span class="rz-cart-btn-ring hidden absolute inset-0 flex items-center justify-center">{% render 'icon-processing', class: 'h-3 w-3 text-content' %}</span>
                                    </div>
                                    <div class="select-none text-content font-medium" data-cart-line-qty></div>
                                    <div role="button" data-cart-action="plus" data-cart-item-id="" data-cart-item-quantity="" class="py-1 px-2 relative">
                                        <span class="rz-cart-btn-icon">{% render 'icon-plus', class: 'h-3 w-3 text-content' %}</span>
                                        <span class="rz-cart-btn-ring hidden absolute inset-0 flex items-center justify-center">{% render 'icon-processing', class: 'h-3 w-3 text-content' %}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
                <div id="cart-drawer-items" class="flex-1 min-h-0 overflow-y-auto {% if cart.empty? %}hidden{% endif %}">
                    <div class="container mt-4 mb-5 mx-auto flex flex-col gap-y-8"></div>
                </div>
                {% assign charity_item = nil %}
                {% assign charity_line = 0 %}
                {% assign charity_has_consent = false %}
                {% for item in cart.items %}
                    {% assign charity_line = charity_line | plus: 1 %}
                    {% if item.product.title contains 'Charity' or item.product.title contains 'Donation' %}
                        {% assign charity_item = item %}
                        {% for property in item.properties %}
                            {% if property.first == '_orbis_tax_receipt_consent' and property.last == 'true' %}
                                {% assign charity_has_consent = true %}
                            {% endif %}
                        {% endfor %}
                        {% break %}
                    {% endif %}
                {% endfor %}
                {% comment %} ── Empty state ── {% endcomment %}
                <div id="cart-drawer-empty" class="shrink {% if cart.empty? == false %}hidden{% endif %}">
                    <div class="container mt-20 mx-auto">
                        <div class="text-center rz-h4">{{ 'templates.cart.empty_message.title' | t }}</div>
                        <div class="text-center mt-4 rz-body-lg">{{ 'templates.cart.empty_message.description' | t }}</div>
                        <a href="{{ routes['collections_url'] }}" title="{{ 'templates.cart.empty_message.button' | t }}" class="block w-fit mx-auto mt-8 rz-btn-md rz-btn-primary">{{ 'templates.cart.empty_message.button' | t }}</a>
                    </div>
                </div>
                <div id="cart-drawer-summary" class="mt-auto shrink {% if cart.empty? %}hidden{% endif %}" style="background-color: rgba(245,245,245,0.6)">
                    <div id="cart-drawer-charity" class="transition-opacity duration-300 border-t border-content/10" style="background-color: rgba(229,229,229,0.6)">
                        <div class="max-w-2xl mx-auto py-3">
                            <div data-charity-donation data-charity-context="cart" data-charity-variant-id="45690314653749" data-charity-base-amount="{{ cart.items_subtotal_price }}">
                                {% comment %} ── State: Donated (compact cart row) ── {% endcomment %}
                                <div data-charity-state="donated" class="{% if charity_item == nil %}hidden{% endif %} transition-opacity duration-200">
                                    <div class="flex items-center justify-between gap-x-4 py-1">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class="flex-shrink-0"><img src="{{ 'partner-logo-orbis.svg' | asset_url }}" alt="Orbis Canada" class="h-4 w-auto"></span>
                                            <span class="text-xs text-content-secondary truncate min-w-0" data-charity-donated-label data-charity-donated-label-template="{{ 'products.product.charity_donation.cart_line_dynamic' | t: type: '__TYPE__' }}">
                                                {%- if charity_item -%}
                                                {%- assign dlabel = false -%}
                                                {%- for property in charity_item.properties -%}
                                                    {%- if property.first == 'donation_type' -%}
                                                        {%- assign dlabel = property.last -%}
                                                    {%- endif -%}
                                                {%- endfor -%}
                                                {%- if dlabel -%}
                                                    {{ 'products.product.charity_donation.cart_line_dynamic' | t: type: dlabel }}
                                                {%- else -%}
                                                    {{ 'products.product.charity_donation.cart_description' | t }}
                                                {%- endif -%}
                                                {%- endif -%}
                                            </span>
                                            <label class="flex items-center gap-1 cursor-pointer select-none group shrink-0" data-charity-consent-row data-charity-consent-toggle>
                                                <input type="checkbox" data-charity-consent-checkbox class="sr-only peer" {% if charity_has_consent %}checked{% endif %}>
                                                <span class="transition-all opacity-20 peer-checked:opacity-100 shrink-0 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-500 peer-focus-visible:rounded-full">{% render 'icon-success', class: 'h-2.5 w-auto fill-brand-500' %}</span>
                                                <span class="text-[10px] text-content-secondary whitespace-nowrap group-hover:text-content transition-colors">{{ 'products.product.charity_donation.consent_label_short' | t }}</span>
                                            </label>
                                            <span role="button" tabindex="0" data-charity-info-action
                                                class="flex-shrink-0 inline-flex items-center gap-1 whitespace-nowrap text-[10px] text-content-tertiary hover:text-content transition-colors rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
                                                aria-label="{{ 'products.product.charity_donation.info_icon_aria' | t }}"
                                                aria-describedby="charity-info-popover">
                                                {% render 'icon-info', class: 'h-2.5 w-auto' %}
                                                <span class="underline underline-offset-4">{{ 'products.product.charity_donation.info_icon_label' | t }}</span>
                                            </span>
                                        </div>
                                        <div class="flex items-center gap-3 shrink-0">
                                            <span data-charity-donation-price class="font-light text-xs">{% if charity_item %}{{ charity_item.final_line_price | money_with_currency }}{% endif %}</span>
                                            <span role="button" data-charity-remove-inline data-charity-variant-id="45690314653749" class="text-xs rz-link cursor-pointer whitespace-nowrap">{{ 'products.product.charity_donation.remove' | t }}</span>
                                        </div>
                                    </div>
                                </div>
                                {% comment %} ── State: Select (chips/custom/summary) ── {% endcomment %}
                                <div data-charity-state="select" class="{% if charity_item %}hidden{% endif %} min-h-[26px] flex flex-col justify-center transition-opacity duration-200">
                                    {% comment %} ── Cart: compact amount selector + consent (right) ── {% endcomment %}
                                    <div class="flex items-center gap-2 flex-wrap">
                                        {% comment %} Row A: chips — compact amount selector {% endcomment %}
                                        <div data-charity-row="chips" class="flex items-center gap-1.5 flex-wrap">
                                            <span class="inline-flex items-center gap-1 text-[11px] text-content-secondary whitespace-nowrap">
                                                <img src="{{ 'partner-logo-orbis.svg' | asset_url }}" alt="Orbis Canada" class="h-3 w-auto flex-shrink-0">
                                            </span>
                                        <span class="inline-flex items-center gap-1">
                                            {%- assign base_amount_cents = cart.items_subtotal_price -%}
                                            {% for pct in (1..3) %}
                                                {% assign pct_amount = base_amount_cents | times: pct | divided_by: 100 %}
                                            <button type="button" data-charity-donate="{{ pct }}"
                                                title="{% if base_amount_cents > 0 %}{{ pct_amount | money_without_trailing_zeros }}{% endif %}"
                                                class="text-[11px] py-1 px-1 rounded border border-content-light bg-surface-white text-content
                                                       hover:border-brand-300 hover:bg-surface-50
                                                       transition-colors duration-200 select-none cursor-pointer whitespace-nowrap">
                                                {{ pct }}%
                                            </button>
                                            {% endfor %}
                                            <button type="button" data-charity-custom-toggle
                                                class="text-[11px] py-1 px-1 rounded border border-content-light bg-surface-white text-content
                                                       hover:border-brand-300 hover:bg-surface-50
                                                       transition-colors duration-200 select-none cursor-pointer whitespace-nowrap">
                                                {{ 'products.product.charity_donation.custom' | t }}
                                            </button>
                                        </span>
                                    </div>
                                    {% comment %} Row B: custom amount {% endcomment %}
                                    <div data-charity-row="custom" class="hidden flex items-center gap-1.5 flex-wrap">
                                        <span class="inline-flex items-center gap-1 text-xs text-content-secondary whitespace-nowrap">
                                            <img src="{{ 'partner-logo-orbis.svg' | asset_url }}" alt="Orbis Canada" class="h-3 w-auto flex-shrink-0">
                                        </span>
                                        <span class="text-xs text-content-secondary">$</span>
                                        <input type="number" data-charity-custom-amount min="0.01" step="0.01" placeholder="0"
                                            class="w-16 bg-transparent border border-content-light rounded px-2 py-1 text-xs text-right focus:outline-none text-content"
                                            aria-label="{{ 'products.product.charity_donation.custom_amount_placeholder' | t }}">
                                        <button type="button" data-charity-donate="custom"
                                            class="rz-btn-xs rz-btn-secondary">
                                            {{ 'products.product.charity_donation.add_donation' | t }}
                                        </button>
                                        <button type="button" data-charity-custom-cancel class="text-xs rz-link cursor-pointer whitespace-nowrap">{{ 'products.product.charity_donation.remove' | t }}</button>
                                    </div>
                                    {% comment %} Row C: summary (JS-populated) {% endcomment %}
                                    <div data-charity-row="summary" class="hidden flex items-center justify-between gap-x-4 py-1">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <img src="{{ 'partner-logo-orbis.svg' | asset_url }}" alt="Orbis Canada" class="h-4 w-auto flex-shrink-0">
                                            <span data-charity-summary-text class="text-xs text-content-secondary truncate"></span>
                                        </div>
                                        <div class="flex items-center gap-3 shrink-0">
                                            <span data-charity-summary-price class="font-light text-xs"></span>
                                            <span role="button" data-charity-remove-inline class="text-xs rz-link cursor-pointer whitespace-nowrap">{{ 'products.product.charity_donation.remove' | t }}</span>
                                        </div>
                                    </div>
                                    {% comment %} Consent + info — always visible, right-aligned {% endcomment %}
                                    <div class="flex items-center gap-1.5 ml-auto">
                                        <label class="flex items-center gap-1 cursor-pointer select-none group" data-charity-consent-row>
                                            <input type="checkbox" data-charity-consent-checkbox class="sr-only peer">
                                            <span class="transition-all opacity-20 peer-checked:opacity-100 shrink-0 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-500 peer-focus-visible:rounded-full">{% render 'icon-success', class: 'h-2.5 w-auto fill-brand-500' %}</span>
                                            <span class="text-[10px] text-content-secondary whitespace-nowrap group-hover:text-content transition-colors">{{ 'products.product.charity_donation.consent_label_cart' | t }}</span>
                                        </label>
                                        <span role="button" tabindex="0" data-charity-info-action
                                            class="inline-flex items-center gap-1 text-[10px] text-content-tertiary hover:text-content transition-colors whitespace-nowrap rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
                                            aria-label="{{ 'products.product.charity_donation.info_icon_aria' | t }}"
                                            aria-describedby="charity-info-popover">
                                            {% render 'icon-info', class: 'h-2.5 w-auto' %}
                                            <span class="underline underline-offset-4">{{ 'products.product.charity_donation.info_icon_label' | t }}</span>
                                        </span>
                                    </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="cart-drawer-footer" class="shrink">
                        <div class="pt-4 pb-2 px-4 sm:px-8">
                            <div class="max-w-2xl mx-auto text-content">
                                <div class="flex justify-between">
                                    <div class="font-bold font-serif text-lg">{{ 'sections.cart.subtotal' | t }}</div>
                                    <div class="font-light text-lg" data-cart-subtotal>{{ cart.items_subtotal_price | money_with_currency }}</div>
                                </div>
                                <div class="mt-1 flex justify-between">
                                    <div class="font-bold font-serif text-base">{{ 'sections.cart.taxes_delivery' | t }}</div>
                                    <div class="font-light italic text-base">{{ 'sections.cart.calculated_checkout' | t }}</div>
                                </div>
                                <a href="{{ shop.url | append: '/checkout' }}" id="checkout" class="block text-center w-full mt-3 rz-btn-md rz-btn-primary" title="{{ 'sections.cart.checkout_now' | t }}">{{ 'sections.cart.checkout_now' | t }}</a>
                            </div>
                        </div>
                        <div class="container mx-auto pt-1 pb-1 flex flex-col items-center justify-center gap-y-2 sm:flex-row sm:gap-x-4">
                            <div class="inline-flex justify-center gap-x-0.5 flex-wrap">
                                {% for type in shop.enabled_payment_types -%}
                                    {{ type | payment_type_svg_tag: class: 'h-4 w-auto' }}
                                {% endfor %}
                            </div>
                            <div data-secure-action="cart" role="button" class="rz-btn-trust flex gap-x-1 text-[10px] py-1 px-4">{% render 'icon-secure', class: 'h-3.5 w-auto fill-content' %} <span>{{ 'sections.footer.ssl_encrypted' | t }}</span></div>
                        </div>
                    </div>
                </div>
        </div>
    </div>
{% endcapture %}
{% render 'component.drawer', drawer_id: 'cart-drawer', drawer_content: drawer_content %}
